{
    "id": "server-${server_name}-${ip}",
    "name": "server-${server_name}-${ip}",
    "tags": ["server"],
    "address": ${ip},
    "port": "${port}",
    "meta": {
        "job": "${server_name}"
    },
    "checks": 
    [
        {
            "http": "http://${ip}:${port}/metrics",
            "interval": "10s",
            "timeout": "5s"
        }
    ]
}